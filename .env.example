# Bloom server configuration. Copy to .env and fill in on the VM:  cp .env.example .env
# Names match server/app/config.py (Settings). Never commit .env.
# Synthetic data only.

# dev = TrustedRouter GLM route with min_privacy="zdr"
# private = only a route tagged "confidential"; fails closed, never falls back
BLOOM_MODE=dev

TRUSTEDROUTER_API_KEY=
TRUSTEDROUTER_BASE_URL=https://api.trustedrouter.com/v1
TR_MODEL_ID=fortanix/glm-5.3-flash
# Model for private mode. Leave empty until NYTE names a confidential route.
PRIVATE_MODEL_ID=
TR_NEGATIVE_TEST_PROVIDER=fortanix

CONTEXT_DEV_API_KEY=
GUIDELINE_DOMAINS=acog.org,uspreventiveservicestaskforce.org,cdc.gov
CONTEXT_DEV_WEBHOOK_SECRET=

# SQLite file on the bloom-data volume (mounted at /data in the api container).
DATABASE_URL=sqlite:////data/bloom.db
# HMAC secret for demo login tokens. Set a long random value (e.g. openssl rand -hex 32)
# so tokens survive an api restart; empty = random per process.
DEMO_LOGIN_SECRET=

# Host port for the web container (docker compose variable, not read by the server).
# BLOOM_HTTP_PORT=80
